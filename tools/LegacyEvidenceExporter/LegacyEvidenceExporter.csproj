<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InspectorDirectory Condition="'$(InspectorDirectory)' == ''">$(MSBuildThisFileDirectory)../../.tools/UeBlueprintDumper-1.2.0/UeBlueprintDumper</InspectorDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UAssetAPI" Version="1.1.0" />
    <Reference Include="CUE4Parse"><HintPath>$(InspectorDirectory)/CUE4Parse.dll</HintPath></Reference>
    <Reference Include="Zlib-ng.NET"><HintPath>$(InspectorDirectory)/Zlib-ng.NET.dll</HintPath></Reference>
    <Reference Include="Oodle.NET"><HintPath>$(InspectorDirectory)/Oodle.NET.dll</HintPath></Reference>
  </ItemGroup>
</Project>
